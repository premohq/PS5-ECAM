msgstr "Khi chỉ có màn hình trên, bàn di cảm ứng vẫn chạm vào màn hình dưới, con trỏ nằm trên màn hình trên (Star Fox 64 3D)."

#: port/app/ingame3ds.cpp:510 port/app/ingame3ds.cpp:518
#, menu
msgid "The screen filter and the performance overlay."
msgstr "Bộ lọc màn hình và lớp phủ hiệu năng."

#: port/app/ingame3ds.cpp:511 port/app/ingame3ds.cpp:519 port/frontend/shell/settings.cpp:741
#, menu
msgid "Screen filter"
msgstr "Bộ lọc màn hình"

#: port/app/ingame3ds.cpp:512
#, menu
msgid "How the game's picture is scaled to the TV. Sharp keeps every pixel square and even; Smooth blurs them together; Square pixels takes the nearest, uneven at most sizes."
msgstr "Cách hình ảnh trò chơi được co giãn lên TV. Sắc nét giữ mỗi điểm ảnh vuông và đều; Mượt làm chúng nhòe vào nhau; Điểm ảnh vuông lấy điểm gần nhất, không đều ở hầu hết các kích thước."

#: port/app/ingame3ds.cpp:515 port/app/ingame3ds.cpp:523 port/app/ingame3ds.cpp:536 port/frontend/shell/settings.cpp:662 port/frontend/shell/settings.cpp:663 port/frontend/shell/settings.cpp:736 port/frontend/shell/settings.cpp:737 port/frontend/shell/settings.cpp:754 port/frontend/shell/settings.cpp:755
#, menu
msgid "The frame rate and the emulation's speed, in the top left corner."
msgstr "Tốc độ khung hình và tốc độ giả lập, ở góc trên bên trái."

#: port/app/ingame3ds.cpp:520
#, menu
msgid "How the DS's 256 x 192 screens are scaled to the TV. Sharp keeps every pixel square and even; Smooth blurs them together; Square pixels takes the nearest, uneven at most sizes."
msgstr "Cách co giãn màn hình 256 x 192 của DS lên TV. Sắc nét giữ mọi điểm ảnh vuông và đều; Mượt làm chúng hòa vào nhau; Điểm ảnh vuông lấy điểm gần nhất, không đều ở hầu hết kích cỡ."

#: port/app/ingame3ds.cpp:528
#, menu
msgid "Internal resolution, texture filter and the performance overlay."
msgstr "Độ phân giải nội bộ, bộ lọc kết cấu và lớp phủ hiệu năng."

#: port/app/ingame3ds.cpp:529 port/frontend/shell/settings.cpp:611 port/frontend/shell/settings.cpp:667
#, menu
msgid "Internal resolution"
msgstr "Độ phân giải nội bộ"

#: port/app/ingame3ds.cpp:530
#, menu
msgid "How large the 3D scenes are drawn before they are scaled to the TV. Higher is sharper and asks more of the GPU."
msgstr "Kích thước vẽ cảnh 3D trước khi co giãn lên TV. Càng cao càng nét và càng nặng cho GPU."

