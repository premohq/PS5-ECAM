#: port/app/ingame3ds.cpp:625 port/frontend/shell/shell.cpp:1509 port/frontend/shell/shell.cpp:1538 port/frontend/shell/shell.cpp:1549 port/frontend/shell/shell.cpp:1555 port/frontend/shell/shell.cpp:1570
