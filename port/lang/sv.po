#: port/frontend/shell/settings.cpp:1557
msgid "Music volume"
msgstr "Musikvolym"

#: port/frontend/shell/settings.cpp:1557
msgid "How loud the menus' music is."
msgstr "Hur högt menyernas musik spelar."

