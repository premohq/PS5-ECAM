#: port/retro/launch.cpp:35
msgid "The emulator could not be started."
msgstr "Emülatör başlatılamadı."

#: port/retro/launch.cpp:43
msgid "This game is no longer where it was, or is not one this side can start."
msgstr "Bu oyun artık eskiden olduğu yerde değil veya bu tarafın başlatabileceği bir oyun değil."

#: port/retro/launch.cpp:47
msgid "This game's folder or name cannot be handed to its emulator: move it or rename it."
msgstr "Bu oyunun klasörü veya adı emülatörüne aktarılamıyor: oyunu taşıyın veya yeniden adlandırın."

#: port/retro/library.cpp:154
msgid "This is not a game this side can start."
msgstr "Bu, bu tarafın başlatabileceği bir oyun değil."

#: port/retro/library.cpp:157 port/retro/library.cpp:177
msgid "The game file is empty or cannot be read."
msgstr "Oyun dosyası boş veya okunamıyor."

#: port/retro/library.cpp:160
msgid "This disc is not a {0} game, or it cannot be read."
msgstr "Bu disk bir {0} oyunu değil veya okunamıyor."

#: port/retro/library.cpp:163
msgid "This game's file is damaged or incomplete: its header is not a cartridge's."
msgstr "Bu oyunun dosyası hasarlı veya eksik: başlığı bir kartuşa ait değil."

#: port/retro/library.cpp:164
msgid "This game is larger than this side's emulator can load."
msgstr "Bu oyun, bu tarafın emülatörünün yükleyebileceğinden daha büyük."

#: port/retro/library.cpp:181
msgid "This side's first emulator cannot read this kind of file: the other one, chosen in its Settings, can."
msgstr "Bu tarafın ilk emülatörü bu tür dosyayı okuyamaz: ayarlarında seçilen diğeri okuyabilir."

#: port/retro/library.cpp:187 port/retro/library.cpp:192
msgid "This {0} archive is damaged or too large."
msgstr "Bu {0} arşivi hasarlı veya çok büyük."

#: port/retro/library.cpp:208
msgid "Famicom Disk System games need its BIOS, disksys.rom (8192 bytes), in {0}."
msgstr "Famicom Disk System oyunları, onun BIOS’una, disksys.rom’a (8192 bayt), {0} içinde ihtiyaç duyar."

#: port/retro/library.cpp:222
msgid "Only the first {0} files in {1} were looked through: choose a folder with fewer."
msgstr "{1} içindeki yalnızca ilk {0} dosyaya bakıldı: daha az dosyası olan bir klasör seçin."

#: port/retro/library.cpp:236
msgid "Not all of {0} could be read: {1}"
msgstr "{0} tamamen okunamadı: {1}"

#. a note from the compatibility list, about how the game runs
#: docs/COMPATIBILITY.md:23
msgctxt "compatibility note"
msgid "Runs at about 60 fps at 1440p. Up to 2.0.0 C it froze and closed when Magnesis or other runes, or the Sheikah scope (R3), highlighted objects; fixed after 2.0.0 C (a newer Cemu)"
msgstr "1440p’de yaklaşık 60 fps ile çalışır. 2.0.0 C’ye kadar Magnesis veya diğer rünler ya da Sheikah dürbünü (R3) nesneleri vurguladığında donup kapanıyordu; 2.0.0 C’den sonra düzeltildi (daha yeni bir Cemu)"

#. a note from the compatibility list, about how the game runs
#: docs/COMPATIBILITY.md:24
msgctxt "compatibility note"
msgid "About half the textures are missing during races"
msgstr "Yarışlar sırasında dokuların yaklaşık yarısı eksik"

#. a note from the compatibility list, about how the game runs
#: docs/COMPATIBILITY.md:25
msgctxt "compatibility note"
msgid "Crashes before it boots on 3.5.0 and earlier: every game started with Pro Controllers for players 2 to 4, and Giants only takes the GamePad at boot. 4.0.0 gives players 2 to 4 a controller only while their DualSense is signed in; not yet confirmed on a console"
msgstr "3.5.0 ve öncesinde açılmadan çöküyor: her oyun 2-4. oyuncular için Pro Controller’larla başlıyordu ve Giants açılışta yalnızca GamePad’i kabul ediyor. 4.0.0 sürümü 2-4. oyunculara yalnızca DualSense’leri oturum açmışken kontrolcü veriyor; henüz bir konsolda doğrulanmadı"

#. a note from the compatibility list, about how the game runs
#: docs/COMPATIBILITY.md:26
msgctxt "compatibility note"
msgid "Crashes after making its save, before the title menu, with every setting at default and no graphic packs"
msgstr "Kaydını oluşturduktan sonra, başlık menüsünden önce çöküyor; tüm ayarlar varsayılanda ve grafik paketi yok"

#. a note from the compatibility list, about how the game runs
#: docs/COMPATIBILITY.md:27
msgctxt "compatibility note"
msgid "Plays with its 60 FPS graphic pack turned off; with it on, it glitches and crashes once gameplay loads. Up to 2.0.0 C it crashed there either way (Cemu ran out of Vulkan descriptors)"
msgstr "60 FPS grafik paketi kapalıyken oynanır; açıkken oynanış yüklenir yüklenmez grafik hataları verir ve çöker. 2.0.0 C’ye kadar orada her durumda çöküyordu (Cemu’nun Vulkan tanımlayıcıları tükeniyordu)"

#. a note from the compatibility list, about how the game runs
#: docs/COMPATIBILITY.md:33
msgctxt "compatibility note"
msgid "Save states work from the in-game menu"
msgstr "Durum kayıtları oyun içi menüden çalışır"

#. a note from the compatibility list, about how the game runs
#: docs/COMPATIBILITY.md:34
msgctxt "compatibility note"
msgid "Moving black dots on outlined 3D models (the Poké Ball and Professor Sycamore in the introduction, then the characters), at any internal resolution. 4.0.0's Outline fix removes them and is on by default for X, Y, Omega Ruby and Alpha Sapphire; it costs some speed"
msgstr "Konturlu 3D modellerde hareket eden siyah noktalar (girişte Poké Ball ve Profesör Sycamore, sonra karakterler), her iç çözünürlükte. 4.0.0 sürümünün kontur düzeltmesi bunları kaldırır ve X, Y, Omega Ruby ve Alpha Sapphire için varsayılan olarak açıktır; biraz hıza mal olur"
