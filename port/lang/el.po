#: port/app/emulator.cpp:867 port/libretro/game.cpp:575
msgid "Touchpad click + Options: the in-game menu (screens, picture, volume, controls, the library)"
msgstr "Κλικ στην επιφάνεια αφής + OPTIONS: το μενού του παιχνιδιού (οθόνες, εικόνα, ένταση, χειρισμός, βιβλιοθήκη)"

#: port/app/emulator.cpp:1102
msgid "PS5-ECAM could not start itself again to show the library: start it again from the home screen."
msgstr "Το PS5-ECAM δεν μπόρεσε να ξεκινήσει ξανά για να δείξει τη βιβλιοθήκη: ξεκινήστε το ξανά από την αρχική οθόνη."

#: port/app/forwarders.cpp:151
msgid "elfldr does not answer on port 9021. Home screen tiles need it, to be put in /data/homebrew and to start their games: load elfldr, then try again."
msgstr "Το elfldr δεν απαντά στη θύρα 9021. Τα εικονίδια της αρχικής οθόνης το χρειάζονται για να μπουν στο /data/homebrew και για να ξεκινούν τα παιχνίδια τους: φορτώστε το elfldr και δοκιμάστε ξανά."

#: port/app/forwarders.cpp:167
msgid "It could not be put in /data/homebrew: {0}"
msgstr "Δεν ήταν δυνατό να μπει στο /data/homebrew: {0}"

#: port/app/forwarders.cpp:172
msgid "elfldr took the tile helper, but the tile did not reach /data/homebrew."
msgstr "Το elfldr πήρε τον βοηθό των εικονιδίων, αλλά το εικονίδιο δεν έφτασε στο /data/homebrew."

#: port/app/forwarders.cpp:269
msgid "It has no home screen tile."
msgstr "Δεν έχει εικονίδιο στην αρχική οθόνη."

#: port/app/forwarders.cpp:277
msgid "{0} could not be removed"
msgstr "Δεν ήταν δυνατή η αφαίρεση του {0}"

#: port/app/forwarders.cpp:305
msgid "The game has no picture for its tile"
msgstr "Το παιχνίδι δεν έχει εικόνα για το εικονίδιό του"

