#: port/app/ingame3ds.cpp:546 port/eden/ingame.cpp:581 port/frontend/shell/settings.cpp:989
#, menu
msgid "How fast the game may run."
msgstr "Πόσο γρήγορα μπορεί να τρέξει το παιχνίδι."

