index bce0587..49f331a 100644
--- a/headless/forwarded_launch.h
+++ b/headless/forwarded_launch.h
@@ -1,13 +1,17 @@
 // SPDX-License-Identifier: GPL-3.0-or-later
 #pragma once
+#include <cstdio>
+#include <fstream>
 #include <string>
 #include <string_view>
+#include <vector>
 
 namespace Eden {
 
 struct ForwardedArgs {
     std::string rom;
     bool exit_after_game = false;
+    std::string return_to;  // --return <eboot>: PS5-ECAM's, which started this program
 };
 
 inline ForwardedArgs ParseForwardedArgs(int argc, char** argv) {
@@ -24,11 +28,32 @@ inline ForwardedArgs ParseForwardedArgs(int argc, char** argv) {
             if (i + 1 < argc && argv[i + 1] != nullptr) result.rom = argv[++i];
         } else if (arg.starts_with(rom_prefix)) {
             result.rom = std::string{arg.substr(rom_prefix.size())};
+        } else if (arg == "--return") {
+            if (i + 1 < argc && argv[i + 1] != nullptr) result.return_to = argv[++i];
+        } else if (arg.starts_with("--return=")) {
+            result.return_to = std::string{arg.substr(9)};
         }
     }
     return result;
 }
 
+// PS5-ECAM puts the arguments it starts this program with in a file too, one a line
+// (launch-request.txt in the data folder): on the console LoadExec does not carry them (MihawkOS saw
+// argc 1 on every restart, and PS5-ECAM 5.0.0's Switch games never started, its #67). Taken once, as
+// the program starts with filesystem access: the file is gone after; empty when there is none.
+inline std::vector<std::string> TakeLaunchRequest(const std::string& file) {
+    std::vector<std::string> args;
+    std::ifstream in(file);
+    if (!in) return args;
+    for (std::string line; std::getline(in, line);) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        args.push_back(std::move(line));
+    }
+    in.close();
+    (void)std::remove(file.c_str());
+    return args;
+}
+
 inline std::string ResolveForwardedRom(std::string_view rom, std::string_view roms_dir) {
     while (!rom.empty() && (rom.back() == ' ' || rom.back() == '\r' || rom.back() == '\n')) rom.remove_suffix(1);
     if (rom.empty()) return {};
