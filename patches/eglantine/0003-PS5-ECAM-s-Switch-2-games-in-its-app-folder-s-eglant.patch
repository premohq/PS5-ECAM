+void eden_set_host_eboot(const char *eboot) { host_eboot = eboot; }
+void eden_stay_closed(void) { return_to_host = 0; }
+static void return_to_host_app(void) {
+    char marker[160];
+    const char *eboots[] = {host_eboot, "/app0/eboot.bin", "/system_ex/app/PPSA99360/eboot.bin",
+                            "/data/homebrew/PPSA99360/eboot.bin"};
