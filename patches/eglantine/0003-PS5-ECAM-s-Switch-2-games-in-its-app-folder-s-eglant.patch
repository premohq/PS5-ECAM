+        if (!eboots[i] || !eboots[i][0]) continue;
+        snprintf(marker, sizeof(marker), "EDEN_PS5ECAM_RETURN %s\n", eboots[i]);
+        sceKernelDebugOutText(0, marker);
+        const int refused = sceSystemServiceLoadExec(eboots[i], NULL);
+        // it does not come back when it works; allow for one that returns before the process ends
