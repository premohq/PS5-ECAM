 #pragma once
 #include <string>
 #include <string_view>
+#include <fstream>
+#include <cstdio>
+#include <utility>
+#include <vector>
 
 namespace Eden {
 
 struct ForwardedArgs {
     std::string rom;
+    std::string ecam_session;
     bool exit_after_game = false;
+    std::vector<std::string> ecam_settings;
 };
 
 inline ForwardedArgs ParseForwardedArgs(int argc, char** argv) {
@@ -20,6 +26,10 @@ inline ForwardedArgs ParseForwardedArgs(int argc, char** argv) {
         const std::string_view arg{argv[i]};
         if (arg == "--exit-after-game") {
             result.exit_after_game = true;
+        } else if (arg == "--ecam-session" && i + 1 < argc && argv[i + 1] != nullptr) {
+            result.ecam_session = argv[++i];
+        } else if (arg == "--ecam-setting" && i + 1 < argc && argv[i + 1] != nullptr) {
+            result.ecam_settings.emplace_back(argv[++i]);
         } else if (arg == rom_flag) {
             if (i + 1 < argc && argv[i + 1] != nullptr) result.rom = argv[++i];
         } else if (arg.starts_with(rom_prefix)) {
@@ -29,6 +39,52 @@ inline ForwardedArgs ParseForwardedArgs(int argc, char** argv) {
     return result;
 }
 
+inline ForwardedArgs ParseForwardedArgs(const std::vector<std::string>& args) {
+    ForwardedArgs result;
+    for (std::size_t i = 0; i < args.size(); ++i) {
+        const std::string_view arg{args[i]};
+        if (arg == "--exit-after-game")
+            result.exit_after_game = true;
+        else if (arg == "--ecam-session" && i + 1 < args.size())
+            result.ecam_session = args[++i];
+        else if (arg == "--ecam-setting" && i + 1 < args.size())
+            result.ecam_settings.push_back(args[++i]);
+        else if (arg == "--rom" && i + 1 < args.size())
+            result.rom = args[++i];
+        else if (arg.starts_with("--rom="))
+            result.rom = std::string{arg.substr(6)};
+    }
+    return result;
+}
+
+inline int EcamSetting(const ForwardedArgs& args, std::string_view key, int fallback = -1) {
+    for (const auto& entry : args.ecam_settings) {
+        const auto equals = entry.find('=');
+        if (equals == std::string::npos || std::string_view{entry}.substr(0, equals) != key) continue;
+        const std::string_view value{entry.data() + equals + 1, entry.size() - equals - 1};
+        if (value.empty() || value.size() > 3) return fallback;
+        int number = 0;
+        for (const char c : value) {
+            if (c < '0' || c > '9') return fallback;
+            number = number * 10 + c - '0';
+        }
+        return number;
+    }
+    return fallback;
+}
+
+inline ForwardedArgs TakeEcamLaunchRequest() {
+    constexpr const char* request = "/data/eglantineps5/ps5ecam-launch-request.txt";
+    std::ifstream in(request);
+    if (!in) return {};
+    std::vector<std::string> args;
+    for (std::string line; std::getline(in, line);)
+        if (!line.empty()) args.push_back(std::move(line));
+    in.close();
+    std::remove(request);
+    return ParseForwardedArgs(args);
+}
+
 inline std::string ResolveForwardedRom(std::string_view rom, std::string_view roms_dir) {
     while (!rom.empty() && (rom.back() == ' ' || rom.back() == '\r' || rom.back() == '\n')) rom.remove_suffix(1);
     if (rom.empty()) return {};
