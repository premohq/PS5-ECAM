 diff --git a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
-index 0c9b8c352d..29ee25d6d8 100644
+index d5fd8e711..1a07271be 100644
 --- a/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
 +++ b/src/shader_recompiler/frontend/ampere/lower_to_maxwell.h
-@@ -1525,14 +1525,17 @@ case 0x311: { // F2I.FTZ.U64.TRUNC, per nvdisasm: Maxwell's F2I gives 32 bits, s
-             if ((!half && !small && !byte && !word) ||
-                 ((byte || small || extended_word) &&
+@@ -2126,9 +2126,7 @@ inline LoweredProgram LowerToMaxwellWith(std::span<const Instruction> code, u32
+                 (signed_half && (insn.Bits(24, 8) || (insn.words[3] & 0xc00001ffU))) ||
+                 ((byte || small || short_trunc || extended_word) &&
                   (insn.Bits(24, 8) || (insn.words[3] & 0xc00001ffU) ||
--                  (opcode == 0xb05 && insn.Bits(62, 2)) ||
-+                  (opcode == 0xb05 && insn.Bits(62, 2) && !small) ||
+-                  (opcode == 0xb05 &&
+-                   (insn.Bits(63, 1) || (!small && insn.Bits(62, 1)) ||
+-                    (small && insn.Bits(59, 3)))) ||
++                  (opcode == 0xb05 && ((!small && insn.Bits(62, 2)) || (small && insn.Bits(59, 3)))) ||
                    insn.Bits(91, 1) != static_cast<u32>(opcode == 0xd05))) ||
-                 (opcode != 0xb05 && (insn.words[1] & 0xffffff00U)) ||
-                 (opcode == 0xd05 && uniform_register(insn.Bits(32, 8)) == ~0U)) {
+                 (opcode != 0xb05 && (insn.words[1] & ~(half ? 0x100000ffU :
+                     0xffU | (absolute ? 0x40000000U : 0U) | (negate ? 0x80000000U : 0U)))) ||
+@@ -2136,7 +2134,10 @@ inline LoweredProgram LowerToMaxwellWith(std::span<const Instruction> code, u32
                  return fail(index, "native float-to-integer conversion mode");
              }
              const bool is_signed = insn.Bits(72, 1);
--            u32 source = opcode == 0xb05 ? materialize(2, 0, 252, false, false)
+-            u32 source = opcode == 0xb05 ? materialize(2, 0, 252, small && insn.Bits(62, 1), false)
 +            // U16 constant sources use the ordinary float absolute/negate bits.
 +            // Apply them before NaN handling, saturation and rounding.
 +            u32 source = opcode == 0xb05 ? materialize(2, 0, 252, small && insn.Bits(62, 1),
 +                                                       small && insn.Bits(63, 1))
                         : opcode == 0xd05 ? uniform_register(insn.Bits(32, 8)) : insn.Bits(32, 8);
              if (half) {
-                 extract_half({source, 2, false, false}, 0, 252);
-diff --git a/src/tests/video_core/ampere_f2i.cpp b/src/tests/video_core/ampere_f2i.cpp
-index 579510f75f..54919344ff 100644
---- a/src/tests/video_core/ampere_f2i.cpp
-+++ b/src/tests/video_core/ampere_f2i.cpp
-@@ -701,4 +701,51 @@ TEST_CASE("Ampere half explicit texel fetches keep unsupported formats and regis
-     invalid[0].words[1] = 0x33c044f6;
-     REQUIRE_FALSE(static_cast<bool>(LowerToMaxwell(invalid)));
- }
-+
-+TEST_CASE("Ampere U16 F2I applies constant float modifiers before conversion",
-+          "[video_core][ampere]") {
-+    // Captured from Pokopia's rejected fragment shader; nvdisasm SM87:
-+    // F2I.FTZ.U16.NTZ R6, |c[0x3][0xd0]|.
-+    for (const u32 predicate : {2U, 7U, 10U}) {
-+        const std::array<Instruction, 2> plain{{
-+            {{0x00060b05U | (predicate << 12), 0x00c03400, 0x00212800, 0x000e2200}},
-+            {{0x0000794d, 0, 0x03800000, 0}},
-+        }};
-+        const auto baseline = LowerToMaxwell(plain);
-+        REQUIRE(static_cast<bool>(baseline));
-+        const u64 guard = u64{predicate} << 16;
-+        REQUIRE(baseline.instructions.front() ==
-+                (0x4c98000000000000ULL | guard | 252 | (15ULL << 39) |
-+                 (0x34ULL << 20) | (3ULL << 34)));
-+        for (const u32 modifier : {0U, 0x40000000U, 0x80000000U, 0xc0000000U}) {
-+            auto code = plain;
-+            code[0].words[1] |= modifier;
-+            const auto lowered = LowerToMaxwell(code);
-+            REQUIRE(static_cast<bool>(lowered));
-+            REQUIRE(lowered.instructions.front() == baseline.instructions.front());
-+            size_t prefix = 1;
-+            if (modifier & 0x40000000U) {
-+                REQUIRE(lowered.instructions[prefix++] ==
-+                        (0x0400000000000000ULL | guard | 252 | (252ULL << 8) |
-+                         (0x7fffffffULL << 20)));
-+            }
-+            if (modifier & 0x80000000U) {
-+                REQUIRE(lowered.instructions[prefix++] ==
-+                        (0x0400000000000000ULL | guard | 252 | (252ULL << 8) |
-+                         (0x80000000ULL << 20) | (2ULL << 53)));
-+            }
-+            // Existing U16 FTZ/NTZ conversion, saturation, and execution guard
-+            // must remain identical after the source modifier instructions.
-+            REQUIRE(lowered.instructions.size() == baseline.instructions.size() + prefix - 1);
-+            REQUIRE(std::equal(baseline.instructions.begin() + 1, baseline.instructions.end(),
-+                               lowered.instructions.begin() + prefix));
-+            auto invalid = code;
-+            invalid[0].words[1] |= 1U << 6; // Unaligned constant-buffer address.
-+            REQUIRE_FALSE(static_cast<bool>(LowerToMaxwell(invalid)));
-+            invalid = code;
-+            invalid[0].words[2] |= 0x08000000U; // Uniform mode on constant source.
-+            REQUIRE_FALSE(static_cast<bool>(LowerToMaxwell(invalid)));
-+        }
-+    }
-+}
- } // namespace
+                 extract_half({source, insn.Bits(60, 1) ? 3U : 2U, false, false}, 0, 252);
