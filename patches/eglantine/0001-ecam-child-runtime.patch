diff --git a/headless/settings_store.h b/headless/settings_store.h
index f8732db..f1743bc 100644
--- a/headless/settings_store.h
+++ b/headless/settings_store.h
@@ -137,0 +138,43 @@ struct Preferences {
+// Settings passed by PS5-ECAM override Eglantine's saved defaults for this child session only.
+// Audio, graphics, language and controls all read PreferencesFor(), so keeping the overlay here
+// makes every subsystem see the same effective values without writing the user's config file.
+struct SessionPreferenceOverrides {
+    int hud = -1, volume = -1, vibration = -1, language = -1;
+    int resolution = -1, filter = -1, output = -1, refresh = -1, frame_gen = -1;
+    int controller = -2;
+};
+
+inline SessionPreferenceOverrides& ActiveSessionPreferenceOverrides() {
+    static SessionPreferenceOverrides value;
+    return value;
+}
+
+inline void SetSessionPreferenceOverrides(const std::vector<std::string>& entries) {
+    SessionPreferenceOverrides value;
+    for (const auto& entry : entries) {
+        const auto equals = entry.find('=');
+        if (equals == std::string::npos) continue;
+        const std::string_view key{entry.data(), equals};
+        const std::string_view text{entry.data() + equals + 1, entry.size() - equals - 1};
+        if (text.empty() || text.size() > 3) continue;
+        int number = 0;
+        bool valid = true;
+        for (const char c : text) {
+            if (c < '0' || c > '9') { valid = false; break; }
+            number = number * 10 + c - '0';
+        }
+        if (!valid) continue;
+        if (key == "hud" && number <= 1) value.hud = number;
+        else if (key == "volume" && number <= 100) value.volume = number;
+        else if (key == "vibration" && number <= 1) value.vibration = number;
+        else if (key == "language" && number >= 1 && number <= int(std::size(kLanguageKeys))) value.language = number - 1;
+        else if (key == "resolution" && number < int(std::size(kResolutionKeys))) value.resolution = number;
+        else if (key == "filter" && number < 4) value.filter = number;
+        else if (key == "output" && number < int(std::size(kOutputKeys))) value.output = number;
+        else if (key == "refresh" && number <= 1) value.refresh = number;
+        else if (key == "frame_gen" && number <= 1) value.frame_gen = number;
+        else if (key == "controller" && number <= int(std::size(kControllerKeys))) value.controller = number - 1;
+    }
+    ActiveSessionPreferenceOverrides() = value;
+}
+
