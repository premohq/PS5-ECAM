+static ps5ingamenx::Settings EcamSettings(const Eden::ForwardedArgs& forwarded) {
+    ps5ingamenx::Settings menu;
+    switch (Settings::values.scaling_filter.GetValue()) {
+    case Settings::ScalingFilter::Fsr: menu.filter = 1; break;
+    case Settings::ScalingFilter::Bicubic: menu.filter = 2; break;
+    case Settings::ScalingFilter::NearestNeighbor: menu.filter = 3; break;
+    default: menu.filter = 0; break;
+    }
+    switch (Settings::values.anti_aliasing.GetValue()) {
+    case Settings::AntiAliasing::Fxaa: menu.antiAliasing = 1; break;
+    case Settings::AntiAliasing::Smaa: menu.antiAliasing = 2; break;
+    default: menu.antiAliasing = 0; break;
+    }
+    menu.sharpening = Settings::values.fsr_sharpening_slider.GetValue();
+    static constexpr int speed_limits[] = {100, 150, 200, 300, 0};
+    const int percent = Settings::values.use_speed_limit.GetValue() ? Settings::values.speed_limit.GetValue() : 0;
+    menu.speedLimit = 4;
+    for (int i = 0; i < 5; ++i)
+        if (speed_limits[i] == percent) menu.speedLimit = i;
+    menu.volume = Eden::PreferencesFor(Eden::session_title.load()).volume;
+    menu.frameGeneration = Settings::values.frame_gen.GetValue();
+#ifdef EDEN_PS5_FRAMEGEN
+    menu.canGenerate = true;
+#endif
+    menu.overlay = Eden::PreferencesFor(Eden::session_title.load()).hud;
+    menu.docked = Settings::values.use_docked_mode.GetValue() == Settings::ConsoleMode::Docked;
+    menu.controller = Eden::session_controller.load();
+    menu.vibration = Settings::values.vibration_enabled.GetValue();
+    menu.deadzone = std::clamp(Eden::EcamSetting(forwarded, "deadzone", 8), 0, 30);
+    return menu;
+}
+
+static void EcamApply(const ps5ingamenx::Settings& menu, Core::System& system, Eden::Pad& pad) {
+    static constexpr Settings::ScalingFilter filters[] = {
+        Settings::ScalingFilter::Bilinear, Settings::ScalingFilter::Fsr,
+        Settings::ScalingFilter::Bicubic, Settings::ScalingFilter::NearestNeighbor};
+    static constexpr Settings::AntiAliasing antialiasing[] = {
+        Settings::AntiAliasing::None, Settings::AntiAliasing::Fxaa, Settings::AntiAliasing::Smaa};
+    static constexpr int speed_limits[] = {100, 150, 200, 300, 0};
+    const int filter = std::clamp(menu.filter, 0, 3);
+    const int speed = speed_limits[std::clamp(menu.speedLimit, 0, 4)];
+    Settings::values.scaling_filter.SetValue(filters[filter]);
+    Settings::values.anti_aliasing.SetValue(antialiasing[std::clamp(menu.antiAliasing, 0, 2)]);
+    Settings::values.fsr_sharpening_slider.SetValue(std::clamp(menu.sharpening, 0, 200));
+    Settings::values.use_speed_limit.SetValue(speed > 0);
+    Settings::values.speed_limit.SetValue(static_cast<u16>(speed > 0 ? speed : 100));
+    Settings::values.volume.SetValue(static_cast<u8>(std::clamp(menu.volume, 0, 100)));
+    Settings::values.use_docked_mode.SetValue(menu.docked ? Settings::ConsoleMode::Docked : Settings::ConsoleMode::Handheld);
+    Settings::values.vibration_enabled.SetValue(menu.vibration);
+    pad.SetDeadzone(std::clamp(menu.deadzone, 0, 30) / 100.0f);
+#ifdef EDEN_PS5_FRAMEGEN
+    Settings::values.frame_gen.SetValue(menu.frameGeneration);
+#endif
+#ifdef EDEN_PS5_OPENGL
+    Eden::SetSessionHud(menu.overlay);
+#endif
+    Eden::session_controller.store(std::clamp(menu.controller, -1, 4));
+    const bool handheld = Eden::ControllerSetting(Eden::session_controller.load()) == Settings::ControllerType::Handheld;
+    Eden::handheld_in_use.store(handheld);
+    if (auto* controller = system.HIDCore().GetEmulatedControllerByIndex(0)) {
+        const auto style = Eden::ChosenStyle(Eden::session_controller.load());
+        controller->SetNpadStyleIndex(style.value_or(Core::HID::NpadStyleIndex::Fullkey));
+        controller->Connect();
+    }
+    for (std::size_t i = 0; i < Eden::Pad::kMaxPlayers; ++i) {
+        auto& player = Settings::values.players.GetValue()[i];
+        player.controller_type = handheld ? Settings::ControllerType::ProController :
+                                            Eden::ControllerSetting(Eden::session_controller.load());
+        player.vibration_enabled = menu.vibration;
+    }
+    LOG_INFO(Frontend, "EDEN_ECAM_MENU filter={} speed={} volume={} frame_gen={}", filter, speed,
+             menu.volume, menu.frameGeneration);
+}
+#endif
