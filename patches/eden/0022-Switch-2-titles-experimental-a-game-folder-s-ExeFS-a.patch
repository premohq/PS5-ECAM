+// SPDX-License-Identifier: GPL-3.0-or-later
+// A game folder that holds its game's ExeFS and RomFS as folders (<game>/exefs/main with main.npdm
+// beside it, <game>/romfs/): how Switch 2 titles are played (experimental, eden-nx2,
+// docs/NX2_PORT.md). Such a game goes by the path of its main, "<game>/exefs/main"; Eden's loader
+// boots that file as a deconstructed ROM directory. After Oliv3rmoon's Nightshade (game_files.h).
+#pragma once
+#include <cctype>
+#include <string_view>
+
+namespace Eden {
+// The main of a game folder's ExeFS: "<game>/exefs/main", or a full path ending so ("exefs" in any
+// case; "main" as Eden names it).
+inline bool IsExeFsMain(std::string_view path) {
+    constexpr std::string_view suffix = "/exefs/main";
+    if (path.size() <= suffix.size()) return false;
+    const std::string_view end = path.substr(path.size() - suffix.size());
+    for (std::size_t i = 0; i < suffix.size(); ++i)
+        if (std::tolower(static_cast<unsigned char>(end[i])) != suffix[i]) return false;
+    path.remove_suffix(suffix.size());
+    return !path.empty() && path.back() != '/';
+}
+// The game folder of an ExeFS main ("<game>" of "<game>/exefs/main"; its full path for a full path).
+inline std::string_view ExeFsGameFolder(std::string_view path) {
+    if (!IsExeFsMain(path)) return {};
+    path.remove_suffix(std::string_view{"/exefs/main"}.size());
+    return path;
+}
+} // namespace Eden
